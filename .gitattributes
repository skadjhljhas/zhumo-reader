# 统一文本文件行尾为 LF，二进制按字节处理
* text=auto eol=lf

# 源码与文档
*.ts       text eol=lf
*.mts      text eol=lf
*.cts      text eol=lf
*.js       text eol=lf
*.mjs      text eol=lf
*.cjs      text eol=lf
*.vue      text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.json     text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.md       text eol=lf
*.svg      text eol=lf

# Windows 专用脚本保持 CRLF
*.ps1      text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf

# 二进制
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.icns     binary
*.exe      binary
*.zip      binary
*.woff     binary
*.woff2    binary
*.ttf      binary
