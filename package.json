{
  "name": "zhumo",
  "zhumoChannel": "preview",
  "version": "2.0.0-preview.13",
  "description": "朱墨 2.0 — 本地 Markdown 阅读与编辑空间",
  "main": "./out/main/index.js",
  "author": "ZhuMo Contributors",
  "license": "LicenseRef-ZhuMo-SAL-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/skadjhljhas/zhumo-reader"
  },
  "bugs": "https://github.com/skadjhljhas/zhumo-reader/issues",
  "homepage": "https://github.com/skadjhljhas/zhumo-reader#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:icons": "node scripts/build-icons.mjs",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "pretest": "node scripts/build-native-file-ops.mjs",
    "test": "vitest run",
    "test:theme-profile": "node scripts/verify/theme-profile.mjs",
    "bench": "node scripts/bench/perf.mjs",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:chaosheng": "node scripts/build-chaosheng.mjs",
    "build:ai": "node scripts/build-ai.mjs",
    "build:release": "node scripts/build-release.mjs",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@mdit/plugin-katex": "^1.1.0",
    "@mdit/plugin-tex": "^1.1.0",
    "@playwright/test": "^1.63.0",
    "@tanstack/vue-virtual": "^3.13.36",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.19.1",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "@webgpu/types": "^0.1.72",
    "@xmldom/xmldom": "^0.9.12",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.15",
    "electron": "~42.10.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "katex": "^0.18.4",
    "lxgw-wenkai-webfont": "^1.7.0",
    "markdown-it": "^15.0.0",
    "markdown-it-cjk-friendly": "^3.0.0",
    "mathjax-full": "^3.2.1",
    "mermaid": "11.17.2",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.11",
    "vue": "^3.5.25",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.6",
    "yauzl": "^3.4.0"
  }
}
